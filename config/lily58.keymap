#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt { tapping-term-ms = <150>; };

/ {
    combos {
        compatible = "zmk,combos";

        Backtick {
            bindings = <&kp GRAVE>;
            key-positions = <13 14>;
        };

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    behaviors {
        hrm_left: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <55 56 57 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49 43 54>;
        };

        hrm_right: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESCAPE                                 &kp N1   &kp N2             &kp N3                &kp N4                    &kp N5                                     &kp N6           &kp N7                      &kp N8                  &kp N9              &kp N0           &kp BACKSPACE
&mt F19 TAB                                &kp Q    &kp W              &kp E                 &kp R                     &kp T                                      &kp Y            &kp U                       &kp I                   &kp O               &kp P            &lt 1 BACKSLASH
&kp LEFT_COMMAND                           &lt 3 A  &hrm_left LCTRL S  &hrm_left LEFT_ALT D  &hrm_left LEFT_COMMAND F  &kp G                                      &kp H            &hrm_right RIGHT_COMMAND J  &hrm_right RIGHT_ALT K  &hrm_right RCTRL L  &lt 3 SEMICOLON  &hrm_right RIGHT_COMMAND SQT
&hrm_left LS(LA(LC(LG(LSHFT)))) LG(SPACE)  &kp Z    &kp X              &kp C                 &kp V                     &kp B           &lt 2 MINUS    &lt 2 PLUS  &kp N            &kp M                       &kp COMMA               &kp DOT             &kp FSLH         &hrm_right LS(LC(LA(RSHFT))) LA(LC(LS(F17)))
                                                                       &kp LEFT_CONTROL      &kp LEFT_ALT              &kp LEFT_SHIFT  &kp SPACE      &kp ENTER   &kp RIGHT_SHIFT  &kp RALT                    &kp RCTRL
            >;

            label = "home";
        };

        bluetooth {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                        &trans  &trans  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT       &kp DELETE
&trans      &sys_reset    &trans        &trans        &kp C_RESET   &trans                              &trans  &trans  &kp INS     &trans            &kp PRINTSCREEN  &trans
&trans      &trans        &trans        &trans        &trans        &trans                              &trans  &trans  &trans      &trans            &trans           &trans
&trans      &trans        &trans        &trans        &trans        &kp PAUSE_BREAK  &trans     &trans  &trans  &trans  &trans      &trans            &trans           &trans
                                        &trans        &trans        &trans           &kp F19    &trans  &trans  &trans  &trans
            >;

            label = "blue";
        };

        function {
            bindings = <
&trans  &kp F1                 &kp F2                 &kp F3                 &kp F4                 &kp F5                                   &kp F6                 &kp F7                 &kp F8                 &kp F9                 &kp F10                        &kp F11
&trans  &kp LC(LA(LG(LS(Q))))  &kp LC(LA(LG(LS(W))))  &kp LC(LA(LG(LS(E))))  &kp LC(LA(LG(LS(R))))  &kp LC(LA(LG(LS(T))))                    &kp LS(LG(LC(LA(Y))))  &kp LS(LG(LC(LA(U))))  &kp LS(LG(LC(LA(I))))  &kp LS(LG(LC(LA(O))))  &kp LS(LG(LC(LA(P))))          &kp F12
&trans  &kp LC(LA(LG(LS(A))))  &kp LC(LA(LG(LS(S))))  &kp LC(LA(LG(LS(D))))  &kp LC(LA(LG(LS(F))))  &kp LC(LA(LG(LS(G))))                    &kp LS(LC(LA(LG(H))))  &kp LS(LC(LA(LG(J))))  &kp LS(LC(LA(LG(K))))  &kp LS(LC(LA(LG(L))))  &kp LS(LC(LA(LG(SEMICOLON))))  &kp LS(LA(LC(LG(APOSTROPHE))))
&trans  &kp LC(LA(LG(LS(Z))))  &kp LC(LA(LG(LS(X))))  &kp LC(LA(LG(LS(C))))  &kp LC(LA(LG(LS(V))))  &kp LC(LA(LG(LS(B))))  &trans    &trans  &kp LS(LC(LG(LA(N))))  &kp LS(LC(LA(LG(M))))  &kp LS(LA(LC(COMMA)))  &kp LS(LC(LA(DOT)))    &kp LS(LC(LA(LG(FSLH))))       &trans
                                                      &trans                 &trans                 &trans                 &trans    &trans  &trans                 &trans                 &trans
            >;

            label = "func";
        };

        semicolon {
            bindings = <
&trans  &kp LS(EXCL)  &kp LS(AT)  &kp LS(POUND)         &kp LS(DLLR)           &kp LS(PRCNT)                             &kp LS(CARET)  &kp LS(AMPS)    &kp LS(STAR)    &kp LS(LPAR)     &kp LS(RPAR)  &kp LS(DELETE)
&trans  &kp GRAVE     &kp TILDE   &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans                                    &kp PG_UP      &kp HOME        &kp UP_ARROW    &kp END          &trans        &trans
&trans  &trans        &trans      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans                                    &kp PG_DN      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans        &trans
&trans  &trans        &trans      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DELETE     &trans           &trans    &kp DEL        &trans          &trans          &trans           &trans        &trans
                                  &trans                &trans                 &trans         &kp BACKSPACE    &kp BSPC  &trans         &trans          &trans
            >;

            label = "semi";
        };
    };
};
